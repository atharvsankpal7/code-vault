{
  "name": "wal-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:producer": "pnpm --filter wal-producer dev",
    "dev:consumer": "pnpm --filter wal-consumer dev",
    "start:producer": "pnpm --filter wal-producer start",
    "start:consumer": "pnpm --filter wal-consumer start",
    "wal-db:generate": "pnpm exec drizzle-kit generate --config packages/wal-db/drizzle.config.ts",
    "wal-db:migrate": "pnpm exec drizzle-kit migrate --config packages/wal-db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@wal/config": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0"
  }
}
